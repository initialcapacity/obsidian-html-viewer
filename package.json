{
  "name": "html-document-viewer",
  "version": "0.0.1788372208",
  "description": "View static HTML files in Obsidian inside a no-script, no-network sandbox.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "typecheck:min": "tsc --noEmit -p tsconfig.min-obsidian.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run typecheck:min && npm run test:coverage && npm run build",
    "fixtures:generate": "node scripts/generate-fixture-assets.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initialcapacity/obsidian-html-viewer.git"
  },
  "author": "Tyson Gern",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "html",
    "viewer",
    "sandbox"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "obsidian": "1.13.1",
    "obsidian-min-api": "npm:obsidian@1.7.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
