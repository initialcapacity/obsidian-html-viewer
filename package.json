{
  "name": "html-document-viewer",
  "version": "0.0.1788317881",
  "description": "View static HTML files in Obsidian inside a no-script, no-network sandbox.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "install:local": "node scripts/install-local.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initialcapacity/obsidian-html-viewer.git"
  },
  "author": "Tyson Gern",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "html",
    "viewer",
    "sandbox"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  }
}
